{
  "name": "ts-pw-aqa",
  "version": "1.0.0",
  "description": "Playwright + TypeScript template for UI autotests",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{ts,mts,json,md,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{ts,mts,json,md,yml,yaml}\" --check",
    "codegen": "playwright codegen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorAndryuschenko/TS-PW-AQA.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "aqa"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IgorAndryuschenko/TS-PW-AQA/issues"
  },
  "homepage": "https://github.com/IgorAndryuschenko/TS-PW-AQA#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-plugin-playwright": "^2.10.2",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.0"
  }
}
